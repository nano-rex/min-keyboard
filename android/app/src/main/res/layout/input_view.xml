<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- Top bar: language, typed text, candidates, AI check, expand -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/mode_switch"
            style="@style/Widget.MinKeyboard.BarButton"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/switch_language"
            android:text="@string/mode_en" />

        <Button
            android:id="@+id/candidate_prev"
            style="@style/Widget.MinKeyboard.BarButton"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:contentDescription="@string/scroll_left"
            android:text="@string/candidate_prev" />

        <TextView
            android:id="@+id/composing_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:maxWidth="120dp"
            android:singleLine="true"
            android:ellipsize="start"
            android:textSize="13sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/candidate_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candidate_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/candidate_next"
            style="@style/Widget.MinKeyboard.BarButton"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:contentDescription="@string/scroll_right"
            android:text="@string/candidate_next" />

        <Button
            android:id="@+id/grammar_button"
            style="@style/Widget.MinKeyboard.BarButton"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/grammar_check"
            android:text="@string/grammar_icon" />

        <Button
            android:id="@+id/candidate_expand"
            style="@style/Widget.MinKeyboard.BarButton"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/more_candidates"
            android:text="@string/candidate_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical">
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" />
        <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
        <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/suggestion_panel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/suggestion_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/suggestion_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/suggestion_slider"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:max="100"
                android:rotation="270" />
        </LinearLayout>
    </LinearLayout>

    <!-- AI grammar check result, shown in place of the keys -->
    <LinearLayout
        android:id="@+id/grammar_panel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/grammar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/grammar_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="false"
                android:textSize="16sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/grammar_dismiss"
                style="@style/Widget.MinKeyboard.BarButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/grammar_dismiss" />

            <Button
                android:id="@+id/grammar_apply"
                style="@style/Widget.MinKeyboard.BarButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/grammar_apply" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
